# System Configuration
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./dris.db
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ADMIN_TOKEN=dris-super-secret-admin-token

# Operational Modes
ALERT_MODE=console
DEMO_MODE=false

# Alert Thresholds (Probability 0.0 - 1.0)
ALERT_THRESHOLD_HIGH=0.70
ALERT_THRESHOLD_SEVERE=0.85
ALERT_COOLDOWN_HOURS=12

# Twilio SMS Credentials (Optional in console mode)
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15005550006

# SMTP Email Credentials (Optional in console mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@dris.gov.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=alerts@dris.gov.in

# GeoJSON & Cache Paths
GEOJSON_PATH=../data/geojson/india_districts.json
CACHE_DIR=../data/cache
MODEL_DIR=../ml/models
